# CONFIG_FILE=/absolute/path/to/config.toml
PUBLIC_BASE_URL=http://localhost:8765
# AUTH_TOKEN=change-me
# Used when the request label is not in LABEL_PROFILES.
DEFAULT_LANGUAGE=nl-NL
DEFAULT_VOICE=nl-NL-FennaNeural
# JSON map used by the plugin's Uitspraak/Pronunciation/发音 labels.
# LABEL_PROFILES={"Uitspraak":{"language":"nl-NL","voice":"nl-NL-FennaNeural"},"Pronunciation":{"language":"en-US","voice":"en-US-AriaNeural"},"发音":{"language":"zh-CN","voice":"zh-CN-XiaoxiaoNeural"}}
# ALLOWED_LANGUAGES=nl-NL,en-US
# ALLOWED_VOICES=nl-NL-FennaNeural,en-US-JennyNeural
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
